# Copy to .env (never commit .env). All values are optional.
HOST=127.0.0.1
PORT=5000
FLASK_DEBUG=0
DATABASE_PATH=backend/privacy_assessments.db
RATE_LIMIT_PER_MINUTE=120
WRITE_RATE_LIMIT_PER_MINUTE=20
RETENTION_DAYS=30
